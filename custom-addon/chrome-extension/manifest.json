{
  "manifest_version": 3,
  "name": "CLIProxyAPI 数据管理面板",
  "version": "1.0.0",
  "description": "为 CLIProxyAPI 管理面板注入「数据管理」页：JSONL 导入/导出、列表/搜索、删除、批量生成配额。仅在 localhost 管理面板注入，不采集任何数据。",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8317/management.html",
        "http://127.0.0.1:8317/management.html"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
